# Ghostty config — единственный, чтобы macOS не пугался Application Support.

# ===========================
# Темы (кастомные, лежат в ~/.config/ghostty/themes/)
# ===========================
# Всегда чёрная тема — без переключения по системному режиму macOS.
# Для настоящего true black на XDR заменишь на XDRBlack (нужен opacity = 1.0).
theme = GrayBlack

# ===========================
# Шрифт
# ===========================
font-family = JetBrainsMonoNL Nerd Font
font-size = 16

# ===========================
# Фон: прозрачность + блюр (паритет с Alacritty).
# При opacity < 1.0 XDR true-black не работает; если переключишься на XDRBlack
# и захочешь чтобы пиксели реально гасились — поставь opacity = 1.0 и убери блюр.
# ===========================
background-opacity = 0.75
background-blur-radius = 20

# ===========================
# Окно
# ===========================
window-padding-x = 24
window-padding-y = 12
window-padding-balance = true
window-width = 160
window-height = 50
confirm-close-surface = false

# Нативный macOS titlebar: AppKit сам прячет tab bar при одной вкладке
# и показывает при двух и более. В fullscreen титульная полоса
# скрывается системой — никакого «всратого» хедера сверху не будет.
# Альтернативы: `tabs` (интегрированные табы, всегда видны),
#               `transparent`, `hidden`.
macos-titlebar-style = native

# Запоминать размер и позицию окна между запусками.
window-save-state = always

# Сглаживание скролла:
#   precision — для трекпада (дефолт 1)
#   discrete  — для колеса мыши (дефолт 3, отсюда «рывки» по 3 строки)
mouse-scroll-multiplier = precision:0.3,discrete:1

