# Ghostty config — единственный, чтобы macOS не пугался Application Support.

# ===========================
# Темы (кастомные, лежат в ~/.config/ghostty/themes/)
# ===========================
# Автопереключение по системному режиму macOS.
#   Light -> LightWhite, Dark -> XDRBlack
theme = light:LightWhite,dark:XDRBlack

# ===========================
# Шрифт
# ===========================
font-family = JetBrainsMonoNL Nerd Font
font-size = 18

# ===========================
# Фон: прозрачность + блюр.
# Компромисс: при opacity < 1.0 XDR true-black не работает (пиксели не гаснут
# до настоящего чёрного). Чтобы вернуть true black — поставь opacity = 1.0
# и закомментируй background-blur-radius.
# ===========================
background-opacity = 0.85
background-blur-radius = 20

# ===========================
# Окно
# ===========================
window-padding-x = 24
window-padding-y = 12
window-padding-balance = true
window-width = 160
window-height = 50
confirm-close-surface = false

# Скрыть верхнюю панель (titlebar). Окно перетаскивается за любую часть,
# трафик-лайты прячутся вместе с панелью.
macos-titlebar-style = hidden

# Запоминать размер и позицию окна между запусками.
window-save-state = always

# Сглаживание скролла:
#   precision — для трекпада (дефолт 1)
#   discrete  — для колеса мыши (дефолт 3, отсюда «рывки» по 3 строки)
mouse-scroll-multiplier = precision:0.4,discrete:1

