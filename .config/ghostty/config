font-family = JetBrainsMonoNL Nerd Font
font-size = 20

# Утолщение глифов (нельзя задать только для светлой темы — опция глобальная,
# но заметнее всего помогает именно на белом фоне). Сила: font-thicken-strength 0..255.
font-thicken = true

# Авто-переключение по системной теме macOS (светлая/тёмная).
theme = light:Rose Pine Dawn,dark:Rose Pine

# Полностью непрозрачный фон (берётся из активной темы).
background-opacity = 1.0

# Встроенный таб-бар в тайтлбаре — компактный look, табы работают.
macos-titlebar-style = tabs

window-padding-x = 24
window-padding-y = 12
window-padding-balance = true
window-width = 160
window-height = 50
confirm-close-surface = false

window-save-state = always

# Скорость колеса мыши (дефолт 3.0)
mouse-scroll-multiplier = 1.0
