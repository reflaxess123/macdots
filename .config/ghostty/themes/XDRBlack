# XDR Pitch Black — настоящий чёрный фон под Apple XDR / mini-LED / OLED
# Использует #000000 чтобы пиксели гасились до минимума яркости.
# Палитра подобрана так, чтобы цвета сочно горели на абсолютной черноте.

background = #000000
foreground = #e8e8e8

cursor-color = #ffffff
cursor-style = block
cursor-style-blink = false

selection-background = #2a2a2a
selection-foreground = #ffffff

# Normal colors (0-7)
palette = 0=#1a1a1a
palette = 1=#ff5d62
palette = 2=#76d7b8
palette = 3=#ffb86c
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#c0caf5

# Bright colors (8-15)
palette = 8=#444444
palette = 9=#ff7a85
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7dcfff
palette = 13=#bb9af7
palette = 14=#73daca
palette = 15=#ffffff
